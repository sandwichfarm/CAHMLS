{
  "name": "@cahmls/sdk",
  "version": "0.1.0",
  "description": "Browser-first SDK for running and talking to Cordn MLS coordinators over Nostr and ContextVM.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": { "types": "./dist/client/index.d.ts", "default": "./dist/client/index.js" },
    "./contracts": { "types": "./dist/contracts/index.d.ts", "default": "./dist/contracts/index.js" },
    "./coordinator": { "types": "./dist/coordinator/index.d.ts", "default": "./dist/coordinator/index.js" },
    "./crypto": { "types": "./dist/crypto/index.d.ts", "default": "./dist/crypto/index.js" },
    "./mls": { "types": "./dist/mls/index.d.ts", "default": "./dist/mls/index.js" },
    "./relay": { "types": "./dist/relay/index.d.ts", "default": "./dist/relay/index.js" },
    "./runtime": { "types": "./dist/runtime/index.d.ts", "default": "./dist/runtime/index.js" },
    "./server": { "types": "./dist/server/index.d.ts", "default": "./dist/server/index.js" },
    "./storage/browser": { "types": "./dist/storage-browser.d.ts", "default": "./dist/storage-browser.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@contextvm/mcp-sdk": "1.30.0",
    "@contextvm/sdk": "0.13.10",
    "@noble/ciphers": "2.2.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "nostr-tools": "2.23.5",
    "ts-mls": "2.0.0-rc.13",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "ws": "8.18.3"
  }
}
